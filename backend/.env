# Database Configuration
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/dash24"

# Legacy MongoDB (keeping for migration reference)
MONGO_URL="mongodb://localhost:27017"
DB_NAME="test_database"

# CORS
CORS_ORIGINS="*"

# JWT Configuration
JWT_SECRET="dash24-v1-secret-change-in-production"
JWT_ALGORITHM="HS256"
JWT_EXPIRY_HOURS=24

# Redis
REDIS_URL="redis://localhost:6379/0"

# EasyEcom (Sandbox) - PENDING CREDENTIALS
EASYECOM_API_KEY=""
EASYECOM_API_SECRET=""
EASYECOM_WAREHOUSE_ID=""
EASYECOM_WEBHOOK_SECRET=""
EASYECOM_SANDBOX=true

# Razorpay (Test Mode)
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="placeholder_secret"
RAZORPAY_WEBHOOK_SECRET=""

# Business Rules
SAME_DAY_CUTOFF_HOUR=14
COD_MAX_AMOUNT=5000
CART_RESERVATION_MINUTES=30
LOW_STOCK_THRESHOLD=5

# Feature Flags
ENABLE_COD=true
ENABLE_WALLET=false
ENABLE_RETENTION=true
